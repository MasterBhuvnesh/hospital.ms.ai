{
  "name": "@hms/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "prisma generate --config=../../apps/identity/prisma/prisma.config.ts",
    "db:migrate": "prisma migrate deploy --config=../../apps/identity/prisma/prisma.config.ts",
    "db:migrate:dev": "prisma migrate dev --config=../../apps/identity/prisma/prisma.config.ts"
  },
  "dependencies": {
    "@hms/config": "workspace:*",
    "@hms/logger": "workspace:*",
    "@prisma/client": "^7.9.1"
  },
  "devDependencies": {
    "prisma": "^7.9.1"
  }
}
