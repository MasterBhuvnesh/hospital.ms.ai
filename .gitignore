# ============================================================
# Root .gitignore for services/
# Covers: Node.js (mail, sms) & Python (pdf-generator)
# ============================================================

# ─── Environment Variables ───────────────────────────────────
.env
.env.*
!.env.example

# ─── Node.js ─────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm
.pnp
.pnp.js

# ─── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
ENV/
pip-log.txt
pip-delete-this-directory.txt
*.egg-info/
dist/
build/
*.egg
.eggs/

# ─── Logs ────────────────────────────────────────────────────
logs/
*.log

# ─── OS & Editor ─────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ─── Docker ──────────────────────────────────────────────────
.docker/

# ─── Misc ────────────────────────────────────────────────────
*.tmp
*.bak
coverage/
.nyc_output/
