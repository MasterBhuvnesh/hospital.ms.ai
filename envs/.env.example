# =============================================================================
#  ATELIER HEALTH - ENVIRONMENT TEMPLATE
#
#  This is the ONLY env file committed to git. Every value here is fake.
#  Copy it, do not edit it in place:
#      cp envs/.env.example envs/.env.development
#
#  APP_ENV selects which file is loaded at boot. packages/config validates
#  the result through a zod schema, so a missing or malformed key fails the
#  service at startup rather than at 3pm on a clinic day.
#
#  CI fails if a service reads a key that is absent from this file.
#
#  Which keys each profile actually needs, and which you have to obtain from
#  a third party, is in envs/CATALOGUE.md.
# =============================================================================


# =============================================================================
#  RUNTIME
# =============================================================================

NODE_ENV=development
APP_ENV=development           # development | testing | container | production
LOG_LEVEL=debug               # trace | debug | info | warn | error

# SERVICE and PORT are NOT set here in development.
#
# Every service has its own port as a constant, and eight services sharing one
# env file cannot share one PORT. They are set only where a single process must
# be told which service to be: the all-in-one image, and per-service Compose or
# Kubernetes definitions.
#
# SERVICE=scheduling
# PORT=5003


# =============================================================================
#  DATASTORES
# =============================================================================

# One base URL, with no schema. packages/db appends `?schema=<service>` from
# SERVICE, because eight services sharing one env file cannot share one schema.
# Host is localhost in development and testing, the service name in a container.
DATABASE_URL=postgresql://hms:hms@localhost:5432/hms
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT=15s

REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=hms

RABBITMQ_URL=amqp://hms:hms@localhost:5672
RABBITMQ_EXCHANGE=hms.events
RABBITMQ_DELAYED_EXCHANGE=hms.delayed
RABBITMQ_PREFETCH=20
RABBITMQ_MAX_RETRIES=5
RABBITMQ_DLQ_SUFFIX=.dlq


# =============================================================================
#  AUTH
#
#  Generate the keypair yourself. It is not obtained from anyone:
#      scripts/dev/generate-jwt-keys.sh
# =============================================================================

# identity ONLY. Never set on another service, in any environment.
JWT_PRIVATE_KEY=
# Every service. The public half of the pair above.
JWT_PUBLIC_KEY=
JWT_ISSUER=atelier-health
JWT_AUDIENCE=atelier-health-api
JWT_ALGORITHM=RS256

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

OTP_TTL=5m
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60s
OTP_LOCKOUT=15m

# Break-glass access expires. An override with no expiry is a permanent grant.
BREAK_GLASS_TTL=30m


# =============================================================================
#  GATEWAY
#
#  Read only by apps/gateway. No other service needs any of these.
# =============================================================================

PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
TRUST_PROXY=false             # true only behind a load balancer you control

# Upstream services. Service DNS names in a container, localhost in development.
IDENTITY_URL=http://localhost:5001
DIRECTORY_URL=http://localhost:5002
SCHEDULING_URL=http://localhost:5003
CLINICAL_URL=http://localhost:5004
COMMERCE_URL=http://localhost:5005
COMMS_URL=http://localhost:5006
AI_URL=http://localhost:5007

UPSTREAM_TIMEOUT=10s
BODY_LIMIT=2mb

RATE_LIMIT_GLOBAL=300         # requests per minute per IP
RATE_LIMIT_AUTH=10            # login and OTP. Deliberately much stricter
RATE_LIMIT_WINDOW=1m

WS_HEARTBEAT=30s
WS_MAX_CONNECTIONS_PER_USER=5


# =============================================================================
#  OBJECT STORAGE
#
#  S3 API. The same keys serve MinIO, Amazon S3, Cloudflare R2 and Ceph.
# =============================================================================

STORAGE_DRIVER=s3-compatible  # s3-compatible | aws-s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=hmsminio
S3_SECRET_KEY=hmsminio
S3_FORCE_PATH_STYLE=true      # required by MinIO, harmless on S3
S3_PRESIGN_TTL=300

S3_BUCKET_DOCUMENTS=hms-documents
S3_BUCKET_PRESCRIPTIONS=hms-prescriptions
S3_BUCKET_INVOICES=hms-invoices
S3_BUCKET_LAB=hms-lab


# =============================================================================
#  NOTIFICATIONS
#
#  Every driver defaults to a stub. Nothing leaves the machine in development
#  or testing, and that guard lives in provider selection rather than in the
#  callers, so a forgotten branch cannot text a real patient.
# =============================================================================

# SMS carries OTP. It is the only channel that works with no app installed,
# and DLT template registration in India has weeks of lead time.
SMS_DRIVER=console            # console | msg91 | gupshup | twilio | sns
SMS_API_KEY=
SMS_SENDER_ID=
SMS_DLT_ENTITY_ID=
SMS_DLT_TEMPLATE_OTP=
SMS_DLT_TEMPLATE_TOKEN=
SMS_DLT_TEMPLATE_REMINDER=

EMAIL_DRIVER=smtp             # smtp | console
SMTP_URL=smtp://localhost:1025
[email protected]
EMAIL_FROM_NAME=Atelier Health

PUSH_DRIVER=console           # console | expo
EXPO_ACCESS_TOKEN=

WHATSAPP_DRIVER=console       # console | cloud-api
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=   # a random string you choose, not issued to you

NOTIFY_QUIET_HOURS_START=21:00
NOTIFY_QUIET_HOURS_END=08:00


# =============================================================================
#  PAYMENTS
# =============================================================================

PAYMENT_DRIVER=stub           # stub | razorpay
PAYMENT_CURRENCY=INR
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=      # HMAC is verified against the RAW request body


# =============================================================================
#  AI
#
#  Any OpenAI-compatible endpoint, including a self-hosted vLLM or Ollama.
# =============================================================================

LLM_DRIVER=stub               # stub | openai-compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=30s
LLM_MAX_TOKENS=2048

EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536     # must match the pgvector column. Changing it is a migration


# =============================================================================
#  PRODUCT BEHAVIOUR
#
#  Not secrets. Defaults that a hospital may override in its own settings.
# =============================================================================

DEFAULT_TIMEZONE=Asia/Kolkata # a fallback only. Every hospital sets its own
DEFAULT_LOCALE=en-IN
NEAR_TURN_TOKENS=3            # warn the patient this many tokens before their turn
QUEUE_POSITION_PUBLISH_INTERVAL=2s
NO_SHOW_GRACE=15m
LAB_RESULT_SLA=24h
IDEMPOTENCY_KEY_TTL=24h
PRESCRIPTION_PDF_RETRY=3


# =============================================================================
#  CLIENTS
# =============================================================================

NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

UPDATE_FEED_URL=
MIN_SUPPORTED_MOBILE_VERSION=1.0.0
MIN_SUPPORTED_DESKTOP_VERSION=1.0.0


# =============================================================================
#  OBSERVABILITY
# =============================================================================

# Set OTEL_ENABLED=true and the endpoint below after `pnpm obs:up`.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318   # Tempo, OTLP over HTTP
OTEL_SERVICE_NAME=
METRICS_ENABLED=true
METRICS_PATH=/metrics         # scraped by Prometheus, never exposed publicly

# Ships pino output to Loki. Unset in development, where logs go to the
# terminal you are already looking at.
LOKI_URL=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1


# =============================================================================
#  Deliberately absent: any AWS_* key.
#
#  No service reads a cloud credential. AWS access exists only where External
#  Secrets talks to Secrets Manager, and where CI assumes a role through OIDC.
#  Both are infrastructure rather than application configuration.
#  See docs/portability.md and envs/CATALOGUE.md section 6.
# =============================================================================
