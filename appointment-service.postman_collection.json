{
  "info": {
    "name": "Atelier Health - Hospital Management System",
    "description": "Complete API collection for the Atelier Health HMS backend. 21 microservices behind an API Gateway.\n\n## Setup\n1. Register a user via Auth > Register\n2. Login via Auth > Login — the token is auto-saved\n3. Use other endpoints as needed\n\n## Variables\n- `baseUrl`: API Gateway URL (default: http://localhost:4000)\n- `token`: JWT token (auto-set on login)\n- `refreshToken`: Refresh token (auto-set on login)",
    "_postman_id": "atelier-health-hms-v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
