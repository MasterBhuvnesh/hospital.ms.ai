  "item": [
    {
      "name": "05 - Appointments",
      "description": "Port 5005 — Appointment booking, status management, and waitlist",
      "item": [
        {
          "name": "Create Appointment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.id) {",
                  "  pm.collectionVariables.set('appointmentId', res.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": \"{{patientId}}\",\n  \"doctorId\": \"{{doctorId}}\",\n  \"hospitalId\": \"{{hospitalId}}\",\n  \"appointmentDate\": \"2026-04-15\",\n  \"slotTime\": \"10:00\",\n  \"type\": \"WALK_IN\",\n  \"reason\": \"Routine checkup\",\n  \"notes\": \"Patient reports mild chest pain\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/appointments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "appointments"
              ]
            }
          }
        },
        {
          "name": "List Appointments",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/appointments?page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "appointments"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "status",
                  "value": "SCHEDULED",
                  "disabled": true
                },
                {
                  "key": "doctorId",
                  "value": "{{doctorId}}",
                  "disabled": true
                },
                {
                  "key": "patientId",
                  "value": "{{patientId}}",
                  "disabled": true
                },
                {
                  "key": "date",
                  "value": "2026-04-15",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Get Appointment by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/appointments/{{appointmentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "appointments",
                "{{appointmentId}}"
              ]
            }
          }
        },
        {
          "name": "Get Doctor Appointments by Date",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/appointments/doctor/{{doctorId}}?date=2026-04-15",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "appointments",
                "doctor",
                "{{doctorId}}"
              ],
              "query": [
                {
                  "key": "date",
                  "value": "2026-04-15"
                }
              ]
            }
          }
        },
        {
          "name": "Get Patient Appointments",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/appointments/patient/{{patientId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "appointments",
                "patient",
                "{{patientId}}"
              ]
            }
          }
        },
        {
          "name": "Update Appointment Status",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CONFIRMED\",\n  \"notes\": \"Confirmed by receptionist\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/appointments/{{appointmentId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "appointments",
                "{{appointmentId}}",
                "status"
              ]
            }
          }
        },
        {
          "name": "Cancel Appointment",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Patient requested cancellation\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/appointments/{{appointmentId}}/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "appointments",
                "{{appointmentId}}",
                "cancel"
              ]
            }
          }
        },
        {
          "name": "Add to Waitlist",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.id) {",
                  "  pm.collectionVariables.set('waitlistId', res.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": \"{{patientId}}\",\n  \"doctorId\": \"{{doctorId}}\",\n  \"hospitalId\": \"{{hospitalId}}\",\n  \"date\": \"2026-04-15\",\n  \"priority\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/appointments/waitlist",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "appointments",
                "waitlist"
              ]
            }
          }
        },
        {
          "name": "Get Waitlist",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/appointments/waitlist/{{doctorId}}?date=2026-04-15",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "appointments",
                "waitlist",
                "{{doctorId}}"
              ],
              "query": [
                {
                  "key": "date",
                  "value": "2026-04-15"
                }
              ]
            }
          }
        },
        {
          "name": "Remove from Waitlist",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/appointments/waitlist/{{waitlistId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "appointments",
                "waitlist",
                "{{waitlistId}}"
              ]
            }
          }
        }
      ]
    }
  ]
}