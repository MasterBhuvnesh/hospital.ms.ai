# Workspace packages resolve to the local source, never the registry.
link-workspace-packages=true
prefer-workspace-packages=true

# Fail rather than silently install a transitive peer that nobody declared.
strict-peer-dependencies=false
auto-install-peers=true

# Keep the store layout strict. A package that imports something it did not
# declare fails here rather than in the container, where the prune step
# removes it.
node-linker=isolated
