{
  "name": "@hms/identity-service",
  "version": "1.0.0",
  "description": "Identity & Access Management Service - Authentication and authorization",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "prisma generate && tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "release": "bash ../../../scripts/version.sh identity-service patch",
    "release:minor": "bash ../../../scripts/version.sh identity-service minor",
    "release:major": "bash ../../../scripts/version.sh identity-service major"
  },
  "dependencies": {
    "@hms/common-logging": "workspace:*",
    "@hms/common-middleware": "workspace:*",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.4.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "prom-client": "^15.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/express-serve-static-core": "^5.1.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.0",
    "prisma": "^6.19.3",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
