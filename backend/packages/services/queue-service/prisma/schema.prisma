generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Hospital Queue Management ───────────────────────

enum TokenStatus {
  WAITING
  CALLED
  IN_PROGRESS
  COMPLETED
  SKIPPED
  CANCELLED
}

enum QueueType {
  OPD
  EMERGENCY
  FOLLOW_UP
}

enum Priority {
  NORMAL
  ELDERLY
  PREGNANT
  DISABLED
  EMERGENCY
}

model QueueToken {
  id            String      @id @default(uuid()) @db.Uuid
  patientId     String      @map("patient_id") @db.Uuid
  doctorId      String      @map("doctor_id") @db.Uuid
  hospitalId    String      @map("hospital_id") @db.Uuid
  appointmentId String?     @map("appointment_id") @db.Uuid
  tokenNumber   String      @map("token_number")
  queueType     QueueType   @default(OPD) @map("queue_type")
  priority      Priority    @default(NORMAL)
  status        TokenStatus @default(WAITING)
  position      Int
  generatedAt   DateTime    @default(now()) @map("generated_at")
  calledAt      DateTime?   @map("called_at")
  completedAt   DateTime?   @map("completed_at")

  @@index([doctorId, hospitalId, status])
  @@index([hospitalId, generatedAt])
  @@index([tokenNumber, hospitalId])
  @@map("queue_tokens")
}

model QueueConfig {
  id                    String   @id @default(uuid()) @db.Uuid
  hospitalId            String   @map("hospital_id") @db.Uuid
  doctorId              String   @map("doctor_id") @db.Uuid
  tokenPrefix           String   @default("A") @map("token_prefix")
  avgConsultationMins   Int      @default(15) @map("avg_consultation_mins")
  maxQueueSize          Int      @default(50) @map("max_queue_size")
  notifyBeforePositions Int      @default(3) @map("notify_before_positions")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@unique([hospitalId, doctorId])
  @@map("queue_configs")
}
