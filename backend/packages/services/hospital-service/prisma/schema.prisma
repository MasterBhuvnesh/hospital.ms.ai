generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("HOSPITAL_DATABASE_URL")
}

// ── Hospital Management ─────────────────────────────

model Hospital {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  address       String
  city          String
  state         String
  pincode       String
  phone         String
  email         String?
  website       String?
  latitude      Decimal? @db.Decimal(10, 7)
  longitude     Decimal? @db.Decimal(10, 7)
  totalBeds     Int      @default(0) @map("total_beds")
  availableBeds Int      @default(0) @map("available_beds")
  icuBeds       Int      @default(0) @map("icu_beds")
  description   String?
  imageUrl      String?  @map("image_url")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  departments Department[]
  services    HospitalService[]
  timings     HospitalTiming[]
  holidays    HospitalHoliday[]

  @@index([city])
  @@map("hospitals")
}

model Department {
  id          String   @id @default(uuid()) @db.Uuid
  hospitalId  String   @map("hospital_id") @db.Uuid
  name        String
  description String?
  headDoctorId String? @map("head_doctor_id") @db.Uuid
  floor       String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
  @@map("departments")
}

model HospitalService {
  id          String   @id @default(uuid()) @db.Uuid
  hospitalId  String   @map("hospital_id") @db.Uuid
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@unique([hospitalId, name])
  @@map("hospital_services")
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model HospitalTiming {
  id         String   @id @default(uuid()) @db.Uuid
  hospitalId String   @map("hospital_id") @db.Uuid
  dayOfWeek  DayOfWeek @map("day_of_week")
  openTime   String   @map("open_time")
  closeTime  String   @map("close_time")
  isClosed   Boolean  @default(false) @map("is_closed")

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@unique([hospitalId, dayOfWeek])
  @@map("hospital_timings")
}

model HospitalHoliday {
  id         String   @id @default(uuid()) @db.Uuid
  hospitalId String   @map("hospital_id") @db.Uuid
  date       DateTime @db.Date
  name       String
  createdAt  DateTime @default(now()) @map("created_at")

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([hospitalId, date])
  @@map("hospital_holidays")
}
