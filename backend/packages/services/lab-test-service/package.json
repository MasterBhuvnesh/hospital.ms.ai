{
  "name": "@hms/lab-test-service",
  "version": "1.0.0",
  "description": "Lab Test Management Service - Diagnostic test workflow",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "prisma generate && tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "release": "bash ../../../scripts/version.sh lab-test-service patch",
    "release:minor": "bash ../../../scripts/version.sh lab-test-service minor",
    "release:major": "bash ../../../scripts/version.sh lab-test-service major"
  },
  "dependencies": {
    "@hms/common-logging": "workspace:*",
    "@hms/common-middleware": "workspace:*",
    "@prisma/client": "6.19.3",
    "dotenv": "^17.4.1",
    "express": "^4.18.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "prisma": "^6.6.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
