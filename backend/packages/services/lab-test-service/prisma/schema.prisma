generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Lab Test Management ─────────────────────────────

enum BookingStatus {
  PENDING
  CONFIRMED
  SAMPLE_COLLECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CollectionType {
  LAB_VISIT
  HOME_COLLECTION
}

model LabTest {
  id                    String   @id @default(uuid()) @db.Uuid
  name                  String
  code                  String   @unique
  description           String?
  category              String
  price                 Decimal  @db.Decimal(10, 2)
  preparationInstructions String? @map("preparation_instructions")
  durationHours         Int      @map("duration_hours")
  sampleType            String   @map("sample_type")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")

  bookings   LabBooking[]
  packageTests TestPackageItem[]

  @@index([category])
  @@map("lab_tests")
}

model LabBooking {
  id              String         @id @default(uuid()) @db.Uuid
  patientId       String         @map("patient_id") @db.Uuid
  doctorId        String?        @map("doctor_id") @db.Uuid
  testId          String         @map("test_id") @db.Uuid
  hospitalId      String?        @map("hospital_id") @db.Uuid
  bookingDate     DateTime       @map("booking_date") @db.Date
  slotTime        String?        @map("slot_time")
  collectionType  CollectionType @default(LAB_VISIT) @map("collection_type")
  status          BookingStatus  @default(PENDING)
  collectionAddress String?      @map("collection_address")
  invoiceId       String?        @map("invoice_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  test LabTest @relation(fields: [testId], references: [id])

  @@index([patientId])
  @@index([status])
  @@map("lab_bookings")
}

model TestPackage {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  discount    Decimal  @default(0) @db.Decimal(5, 2)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  tests TestPackageItem[]

  @@map("test_packages")
}

model TestPackageItem {
  id        String @id @default(uuid()) @db.Uuid
  packageId String @map("package_id") @db.Uuid
  testId    String @map("test_id") @db.Uuid

  package TestPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  test    LabTest     @relation(fields: [testId], references: [id])

  @@unique([packageId, testId])
  @@map("test_package_items")
}
