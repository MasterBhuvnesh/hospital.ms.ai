{
  "name": "@hms/notification-service",
  "version": "1.0.0",
  "description": "Notification Service - Email notifications",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "release": "bash ../../../scripts/version.sh notification-service patch",
    "release:minor": "bash ../../../scripts/version.sh notification-service minor",
    "release:major": "bash ../../../scripts/version.sh notification-service major"
  },
  "dependencies": {
    "@hms/common-logging": "workspace:*",
    "@hms/common-middleware": "workspace:*",
    "dotenv": "^17.4.1",
    "express": "^4.18.2",
    "nodemailer": "^6.9.0",
    "prom-client": "^15.1.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/nodemailer": "^6.4.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.4",
    "supertest": "^7.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.4"
  }
}
