# ──────────────────────────────────────────────────
# notification-service — Environment Variables
# ──────────────────────────────────────────────────
# Copy to .env:  cp .env.example .env
# ──────────────────────────────────────────────────

# Server
PORT=5015
NODE_ENV=development

# Redis
REDIS_URL=redis://:hms_redis_secret@localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://hms_rabbit:hms_rabbit_secret@localhost:5672

# SMTP (AWS SES)
# If SMTP_HOST is not set, it's auto-derived from AWS_REGION
AWS_REGION=ap-south-1
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=your-ses-smtp-username
SMTP_PASS=your-ses-smtp-password
SMTP_FROM=noreply@hospital.ms
