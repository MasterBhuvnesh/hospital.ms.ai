{
  "name": "@hms/api-gateway",
  "version": "1.0.0",
  "description": "API Gateway - Single entry point for all client requests",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "release": "bash ../../../scripts/version.sh api-gateway patch",
    "release:minor": "bash ../../../scripts/version.sh api-gateway minor",
    "release:major": "bash ../../../scripts/version.sh api-gateway major"
  },
  "dependencies": {
    "@hms/common-logging": "workspace:*",
    "@hms/common-middleware": "workspace:*",
    "dotenv": "^17.4.1",
    "express": "^4.18.2",
    "zod": "^3.25.76",
    "jsonwebtoken": "^9.0.2",
    "http-proxy-middleware": "^3.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "@types/jsonwebtoken": "^9.0.10"
  }
}
