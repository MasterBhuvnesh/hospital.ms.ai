generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Analytics ───────────────────────────────────────

model DailyMetric {
  id               String   @id @default(uuid()) @db.Uuid
  hospitalId       String?  @map("hospital_id") @db.Uuid
  date             DateTime @db.Date
  totalPatients    Int      @default(0) @map("total_patients")
  totalConsultations Int    @default(0) @map("total_consultations")
  totalAppointments Int     @default(0) @map("total_appointments")
  noShows          Int      @default(0) @map("no_shows")
  avgWaitTimeMins  Decimal? @map("avg_wait_time_mins") @db.Decimal(6, 2)
  avgConsultMins   Decimal? @map("avg_consult_mins") @db.Decimal(6, 2)
  revenue          Decimal  @default(0) @db.Decimal(12, 2)
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([hospitalId, date])
  @@index([date])
  @@map("daily_metrics")
}

model DoctorDailyMetric {
  id               String   @id @default(uuid()) @db.Uuid
  doctorId         String   @map("doctor_id") @db.Uuid
  hospitalId       String?  @map("hospital_id") @db.Uuid
  date             DateTime @db.Date
  patientsSeen     Int      @default(0) @map("patients_seen")
  avgConsultMins   Decimal? @map("avg_consult_mins") @db.Decimal(6, 2)
  avgRating        Decimal? @map("avg_rating") @db.Decimal(3, 2)
  revenue          Decimal  @default(0) @db.Decimal(12, 2)
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([doctorId, hospitalId, date])
  @@index([date])
  @@map("doctor_daily_metrics")
}

model QueueStat {
  id              String   @id @default(uuid()) @db.Uuid
  hospitalId      String   @map("hospital_id") @db.Uuid
  doctorId        String?  @map("doctor_id") @db.Uuid
  date            DateTime @db.Date
  hour            Int
  tokensIssued    Int      @default(0) @map("tokens_issued")
  avgWaitMins     Decimal? @map("avg_wait_mins") @db.Decimal(6, 2)
  peakQueueSize   Int      @default(0) @map("peak_queue_size")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([hospitalId, doctorId, date, hour])
  @@index([date])
  @@map("queue_stats")
}
