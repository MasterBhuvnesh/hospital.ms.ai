generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("LAB_RESULT_DATABASE_URL")
}

// ── Lab Results ─────────────────────────────────────

enum ResultStatus {
  PENDING
  PROCESSING
  COMPLETED
  VERIFIED
  DELIVERED
}

model LabResult {
  id          String       @id @default(uuid()) @db.Uuid
  bookingId   String       @map("booking_id") @db.Uuid
  patientId   String       @map("patient_id") @db.Uuid
  testId      String       @map("test_id") @db.Uuid
  doctorId    String?      @map("doctor_id") @db.Uuid
  status      ResultStatus @default(PENDING)
  reportUrl   String?      @map("report_url")
  s3Key       String?      @map("s3_key")
  technicianId String?     @map("technician_id") @db.Uuid
  verifiedById String?     @map("verified_by_id") @db.Uuid
  isCritical  Boolean      @default(false) @map("is_critical")
  notes       String?
  completedAt DateTime?    @map("completed_at")
  deliveredAt DateTime?    @map("delivered_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  values ResultValue[]

  @@index([patientId])
  @@index([bookingId])
  @@index([status])
  @@map("lab_results")
}

model ResultValue {
  id           String   @id @default(uuid()) @db.Uuid
  resultId     String   @map("result_id") @db.Uuid
  parameterName String  @map("parameter_name")
  value        String
  unit         String?
  normalMin    Decimal? @map("normal_min") @db.Decimal(10, 3)
  normalMax    Decimal? @map("normal_max") @db.Decimal(10, 3)
  isAbnormal   Boolean  @default(false) @map("is_abnormal")
  createdAt    DateTime @default(now()) @map("created_at")

  result LabResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@map("result_values")
}
