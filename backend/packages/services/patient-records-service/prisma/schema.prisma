generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("PATIENT_RECORDS_DATABASE_URL")
}

// ── Patient Records ─────────────────────────────────

enum BloodGroup {
  A_POSITIVE    @map("A+")
  A_NEGATIVE    @map("A-")
  B_POSITIVE    @map("B+")
  B_NEGATIVE    @map("B-")
  AB_POSITIVE   @map("AB+")
  AB_NEGATIVE   @map("AB-")
  O_POSITIVE    @map("O+")
  O_NEGATIVE    @map("O-")
}

model Patient {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @unique @map("user_id") @db.Uuid
  firstName     String      @map("first_name")
  lastName      String      @map("last_name")
  dateOfBirth   DateTime    @map("date_of_birth") @db.Date
  gender        String
  bloodGroup    BloodGroup? @map("blood_group")
  address       String?
  emergencyContact String?  @map("emergency_contact")
  emergencyPhone   String?  @map("emergency_phone")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  allergies       Allergy[]
  medicalHistory  MedicalHistory[]
  documents       Document[]
  immunizations   Immunization[]
  accessGrants    RecordAccess[]

  @@map("patients")
}

model Allergy {
  id        String   @id @default(uuid()) @db.Uuid
  patientId String   @map("patient_id") @db.Uuid
  allergen  String
  severity  String
  reaction  String?
  createdAt DateTime @default(now()) @map("created_at")

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("allergies")
}

model MedicalHistory {
  id          String   @id @default(uuid()) @db.Uuid
  patientId   String   @map("patient_id") @db.Uuid
  condition   String
  diagnosedAt DateTime? @map("diagnosed_at") @db.Date
  status      String    @default("active")
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("medical_history")
}

model Document {
  id          String   @id @default(uuid()) @db.Uuid
  patientId   String   @map("patient_id") @db.Uuid
  fileName    String   @map("file_name")
  fileType    String   @map("file_type")
  fileSize    Int      @map("file_size")
  s3Key       String   @map("s3_key")
  category    String
  description String?
  uploadedAt  DateTime @default(now()) @map("uploaded_at")

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("documents")
}

model Immunization {
  id          String    @id @default(uuid()) @db.Uuid
  patientId   String    @map("patient_id") @db.Uuid
  vaccineName String    @map("vaccine_name")
  doseNumber  Int       @map("dose_number")
  givenAt     DateTime  @map("given_at") @db.Date
  nextDueAt   DateTime? @map("next_due_at") @db.Date
  provider    String?
  createdAt   DateTime  @default(now()) @map("created_at")

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("immunizations")
}

model RecordAccess {
  id         String   @id @default(uuid()) @db.Uuid
  patientId  String   @map("patient_id") @db.Uuid
  doctorId   String   @map("doctor_id") @db.Uuid
  grantedAt  DateTime @default(now()) @map("granted_at")
  expiresAt  DateTime? @map("expires_at")
  isRevoked  Boolean  @default(false) @map("is_revoked")

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([patientId, doctorId])
  @@map("record_access")
}
