{
  "name": "@hms/search-service",
  "version": "1.0.0",
  "description": "Search & Discovery Service - Find doctors and hospitals",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "release": "bash ../../../scripts/version.sh search-service patch",
    "release:minor": "bash ../../../scripts/version.sh search-service minor",
    "release:major": "bash ../../../scripts/version.sh search-service major"
  },
  "dependencies": {
    "@hms/common-logging": "workspace:*",
    "@hms/common-middleware": "workspace:*",
    "dotenv": "^17.4.1",
    "express": "^4.18.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
