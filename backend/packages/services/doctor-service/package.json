{
  "name": "@hms/doctor-service",
  "version": "1.0.0",
  "description": "Doctor Management Service - Doctor profiles, attendance, and availability",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "prisma generate && tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "release": "bash ../../../scripts/version.sh doctor-service patch",
    "release:minor": "bash ../../../scripts/version.sh doctor-service minor",
    "release:major": "bash ../../../scripts/version.sh doctor-service major"
  },
  "dependencies": {
    "@hms/common-logging": "workspace:*",
    "@prisma/client": "6.19.3",
    "dotenv": "^17.4.1",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "prisma": "^6.6.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
