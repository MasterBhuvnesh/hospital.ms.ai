{
  "name": "@hms/common-middleware",
  "version": "1.0.0",
  "description": "Shared Express middleware for HMS services — error handling, validation, auth",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "release": "bash ../../../scripts/version.sh middleware patch",
    "release:minor": "bash ../../../scripts/version.sh middleware minor",
    "release:major": "bash ../../../scripts/version.sh middleware major"
  },
  "dependencies": {
    "zod": "^3.24.0"
  },
  "peerDependencies": {
    "express": "^4.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "express": "^4.18.2",
    "typescript": "^5.3.3"
  }
}
