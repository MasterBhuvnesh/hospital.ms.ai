{
  "name": "@hms/common-pdf",
  "version": "1.0.0",
  "description": "Shared PDF generation library for HMS services using pdf-lib + GoogleSans",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./templates/*": {
      "import": "./dist/templates/*.js",
      "types": "./dist/templates/*.d.ts"
    }
  },
  "scripts": {
    "build": "tsc && npm run copy-fonts",
    "copy-fonts": "node -e \"const fs=require('fs');fs.cpSync('src/fonts','dist/fonts',{recursive:true})\"",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "release": "bash ../../../scripts/version.sh pdf patch",
    "release:minor": "bash ../../../scripts/version.sh pdf minor",
    "release:major": "bash ../../../scripts/version.sh pdf major"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  }
}
