{
  "name": "hospital-management-system",
  "version": "1.0.0",
  "description": "AI-Augmented Hospital Management System - Microservices Architecture",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter \"./packages/**\" --parallel dev",
    "build": "pnpm --filter \"./packages/**\" build",
    "test": "pnpm --filter \"./packages/**\" test",
    "lint": "pnpm --filter \"./packages/**\" lint",
    "typecheck": "pnpm --filter \"./packages/**\" typecheck",
    "format": "prettier --write .",
    "docker:build": "pnpm --filter \"./packages/**\" docker:build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "devDependencies": {
    "prettier": "^3.8.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@10.29.3"
}
