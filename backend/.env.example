# ──────────────────────────────────────────────────────
# HMS — Infrastructure Environment Variables
# ──────────────────────────────────────────────────────
# Used by docker-compose.db.yml for infrastructure services.
# Per-service env vars are in each service's own .env file.
#
# Quick start:
#   cp .env.example .env
#   bash scripts/setup-env.sh        # generates all per-service .env files
# ──────────────────────────────────────────────────────

# ── PostgreSQL ─────────────────────────────────────────
POSTGRES_USER=hms_admin
POSTGRES_PASSWORD=hms_secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Redis ──────────────────────────────────────────────
REDIS_PASSWORD=hms_redis_secret

# ── MinIO (S3-compatible) ──────────────────────────────
MINIO_ROOT_USER=hms_minio
MINIO_ROOT_PASSWORD=hms_minio_secret

# ── RabbitMQ ───────────────────────────────────────────
RABBITMQ_USER=hms_rabbit
RABBITMQ_PASSWORD=hms_rabbit_secret
