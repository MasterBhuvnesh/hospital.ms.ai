# ──────────────────────────────────────────────────────
# HMS — Environment Variables
# ──────────────────────────────────────────────────────
# Copy this file to .env and update values for your environment.
#   cp .env.example .env
# ──────────────────────────────────────────────────────

# ── PostgreSQL ─────────────────────────────────────────
POSTGRES_USER=hms_admin
POSTGRES_PASSWORD=hms_secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Per-service DATABASE_URL (Prisma format)
IDENTITY_DATABASE_URL=postgresql://hms_admin:hms_secret@localhost:5432/hms_identity?schema=public
DOCTOR_DATABASE_URL=postgresql://hms_admin:hms_secret@localhost:5432/hms_doctor?schema=public
HOSPITAL_DATABASE_URL=postgresql://hms_admin:hms_secret@localhost:5432/hms_hospital?schema=public
APPOINTMENT_DATABASE_URL=postgresql://hms_admin:hms_secret@localhost:5432/hms_appointment?schema=public
QUEUE_DATABASE_URL=postgresql://hms_admin:hms_secret@localhost:5432/hms_queue?schema=public
PATIENT_RECORDS_DATABASE_URL=postgresql://hms_admin:hms_secret@localhost:5432/hms_patient_records?schema=public
CONSULTATION_DATABASE_URL=postgresql://hms_admin:hms_secret@localhost:5432/hms_consultation?schema=public
PRESCRIPTION_DATABASE_URL=postgresql://hms_admin:hms_secret@localhost:5432/hms_prescription?schema=public
LAB_TEST_DATABASE_URL=postgresql://hms_admin:hms_secret@localhost:5432/hms_lab_test?schema=public
LAB_RESULT_DATABASE_URL=postgresql://hms_admin:hms_secret@localhost:5432/hms_lab_result?schema=public
PHARMACY_DATABASE_URL=postgresql://hms_admin:hms_secret@localhost:5432/hms_pharmacy?schema=public
INVENTORY_DATABASE_URL=postgresql://hms_admin:hms_secret@localhost:5432/hms_inventory?schema=public
BILLING_DATABASE_URL=postgresql://hms_admin:hms_secret@localhost:5432/hms_billing?schema=public
PATIENT_SHEET_DATABASE_URL=postgresql://hms_admin:hms_secret@localhost:5432/hms_patient_sheet?schema=public
ANALYTICS_DATABASE_URL=postgresql://hms_admin:hms_secret@localhost:5432/hms_analytics?schema=public
CALLING_DATABASE_URL=postgresql://hms_admin:hms_secret@localhost:5432/hms_calling?schema=public

# ── Redis ──────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=hms_redis_secret
REDIS_URL=redis://:hms_redis_secret@localhost:6379

# ── Elasticsearch ──────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200

# ── MinIO (S3-compatible) ──────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=hms_minio
MINIO_ROOT_PASSWORD=hms_minio_secret
MINIO_USE_SSL=false

# S3 Bucket Names
S3_BUCKET_MEDICAL_DOCS=hms-medical-docs
S3_BUCKET_LAB_REPORTS=hms-lab-reports
S3_BUCKET_CALL_RECORDINGS=hms-call-recordings

# ── RabbitMQ ───────────────────────────────────────────
RABBITMQ_USER=hms_rabbit
RABBITMQ_PASSWORD=hms_rabbit_secret
RABBITMQ_URL=amqp://hms_rabbit:hms_rabbit_secret@localhost:5672

# ── Service Ports ──────────────────────────────────────
API_GATEWAY_PORT=4000
IDENTITY_SERVICE_PORT=5001
DOCTOR_SERVICE_PORT=5002
HOSPITAL_SERVICE_PORT=5003
SEARCH_SERVICE_PORT=5004
APPOINTMENT_SERVICE_PORT=5005
QUEUE_SERVICE_PORT=5006
PATIENT_RECORDS_SERVICE_PORT=5007
CONSULTATION_SERVICE_PORT=5008
PRESCRIPTION_SERVICE_PORT=5009
LAB_TEST_SERVICE_PORT=5010
LAB_RESULT_SERVICE_PORT=5011
PHARMACY_SERVICE_PORT=5012
INVENTORY_SERVICE_PORT=5013
BILLING_SERVICE_PORT=5014
NOTIFICATION_SERVICE_PORT=5015
PATIENT_SHEET_SERVICE_PORT=5016
REALTIME_SERVICE_PORT=5017
ANALYTICS_SERVICE_PORT=5018
CALLING_SERVICE_PORT=5019
WHATSAPP_SERVICE_PORT=5020

# ── JWT ────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Node Environment ──────────────────────────────────
NODE_ENV=development
